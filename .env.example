# Kopyalayın: cp .env.example .env  — .env dosyasını ASLA depoya eklemeyin. Değerleri rastgele üretin: openssl rand -base64 32
APP_DOMAIN=fiyat.sirketiniz.com.tr
# Şirket içi alan adı ise: TLS_MODE=tls internal
TLS_MODE=
# Erişim sınırı (boşlukla ayrılmış CIDR listesi). Örn: 10.0.0.0/8 192.168.0.0/16
ALLOWED_CIDRS=0.0.0.0/0 ::/0
POSTGRES_PASSWORD=DEGISTIRIN
REDIS_PASSWORD=DEGISTIRIN
DATABASE_URL=postgres://ragyu:DEGISTIRIN@db:5432/ragyu
REDIS_URL=redis://:DEGISTIRIN@redis:6379
# İlk yöneticiyi oluşturmak için (en az 16 karakter). Yönetici oluşturulduktan sonra silebilirsiniz.
SETUP_TOKEN=DEGISTIRIN-EN-AZ-16-KARAKTER
COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
LOGIN_MAX_FAILS=5
# Gerçek rakip taraması için boş bırakın. Yalnızca demo için doldurulur.
SCRAPER_ALLOW_HOSTS=
API_URL=http://api:4000
NODE_ENV=production
