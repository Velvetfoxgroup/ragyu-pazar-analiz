{
  "name": "ragyu-pazar-analiz",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build -w @ragyu/core && npm run build -w @ragyu/api && npm run build -w @ragyu/worker && npm run build -w @ragyu/web",
    "migrate": "tsx packages/core/src/cli/migrate.ts",
    "seed:demo": "tsx apps/sample-site/seed.ts",
    "admin:create": "tsx packages/core/src/cli/create-admin.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:sample": "tsx apps/sample-site/server.ts",
    "dev:web": "npm run dev -w @ragyu/web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
